{
  "_comment": "REAL-DATA configuration with calibration values measured from capacitive soil moisture sensor. soil_raw_dry=620 (air-dry reading), soil_raw_wet=270 (saturated soil reading), moisture_threshold_pct=35 chosen after calibration to trigger watering when soil feels dry to touch.",

  "soil_raw_dry": 620,
  "soil_raw_wet": 270,
  "moisture_threshold_pct": 35.0,

  "soil_feature": "moisture_pct",
  "adc_max": 1023,
  "valid_ranges": {
    "temperature_c": [0, 50],
    "humidity_pct": [0, 100]
  },

  "random_seed": 42,
  "split": {
    "strategy": "auto",
    "test_size": 0.25,
    "min_sessions_for_group_split": 5
  },
  "cv_folds": 5,
  "selection_metric": "f2",

  "models": {
    "logistic_regression": {"C": 1.0},
    "decision_tree": {"max_depth": 3, "min_samples_leaf": 5},
    "random_forest": {"n_estimators": 10, "max_depth": 3, "min_samples_leaf": 5}
  },

  "paths": {
    "data_dir": "data/raw",
    "processed_dir": "data/processed",
    "model_dir": "models",
    "report_dir": "reports",
    "firmware_model_header": "firmware/arduino/ml_controller/model.h"
  },
  "is_demo": false
}
